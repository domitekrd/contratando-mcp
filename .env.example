# Copiar a .env y rellenar. NUNCA commitear .env.

# URL base de la app de Contratando (sin barra al final).
MCP_BRIDGE_URL="https://contratandord.com"

# El mismo secreto que MCP_API_SECRET en el .env de Contratando
# (src/app/api/mcp/route.ts). Generar uno nuevo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# y ponerlo en LOS DOS lados (acá y en el .env de Contratando) — si no
# coinciden, el puente rechaza todo.
MCP_API_SECRET=""
